#!/usr/bin/env bash
# Pre-commit hook: format + lint.
# Skip with: git commit --no-verify
# Run tests too with: BWA_MEM2_RS_PRECOMMIT_TEST=1 git commit
set -euo pipefail

if [[ ! -f "Cargo.toml" ]]; then
    echo "error: not in bwa-mem2-rs root" >&2
    exit 1
fi

echo "==> cargo ci-fmt"
cargo ci-fmt

echo "==> cargo ci-lint"
# The stable-only clippy settings CI's lint job uses (.config/clippy/clippy.toml).
# Clippy before 0.1.87 (Rust 1.87) rejects their key, so an older toolchain
# (e.g. RUSTUP_TOOLCHAIN=1.75.0, the MSRV) lints without them.
clippy_version="$(cargo clippy --version)"
if [[ "${clippy_version}" =~ ^clippy\ 0\.1\.([0-9]+) ]] && (( BASH_REMATCH[1] >= 87 )); then
    CLIPPY_CONF_DIR="${PWD}/.config/clippy" cargo ci-lint
else
    echo "    (${clippy_version}: too old for .config/clippy, linting without it)"
    # Drop an inherited CLIPPY_CONF_DIR too, which may name the same directory.
    (unset CLIPPY_CONF_DIR; cargo ci-lint)
fi

# Python static analysis for the bwa-mem3-py bindings. Skipped (with a note)
# when pixi isn't installed so the hook stays usable on Rust-only setups.
if command -v pixi >/dev/null 2>&1; then
    echo "==> pixi run check-all (Python: ruff format + lint)"
    pixi run --manifest-path bwa-mem3-py/pixi.toml check-all
else
    echo "==> skipping Python checks (pixi not found on PATH)"
fi

if [[ "${BWA_MEM2_RS_PRECOMMIT_TEST:-0}" == "1" ]]; then
    echo "==> cargo ci-test"
    cargo ci-test
fi
